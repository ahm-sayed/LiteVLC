<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LiteVLC</AssemblyName>
    <RootNamespace>LiteVLC</RootNamespace>
    <Version>1.4.0</Version>
    <Product>LiteVLC</Product>
    <Description>Ultra-lightweight, zero-seek-lag media player clone built from REA analysis of VLC</Description>
    <ApplicationIcon>Assets\LiteVLC.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\LiteVLC.ico" />
    <Resource Include="Assets\LiteVLC.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="native\libmpv-2.dll" Condition="Exists('native\libmpv-2.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <Link>libmpv-2.dll</Link>
    </None>
  </ItemGroup>

</Project>
