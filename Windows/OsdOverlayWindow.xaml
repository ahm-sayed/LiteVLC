<Window x:Class="LiteVLC.Windows.OsdOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        Focusable="False">
    <Grid Margin="22">
        <!-- Live Performance HUD (Top-Left, toggle via 'I') -->
        <Border x:Name="HudPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#D80B0F18"
                BorderBrush="#4438BDF8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                    <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="LITEVLC ENGINE HUD"
                               Foreground="#E2E8F0"
                               FontSize="10.5"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="94"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Video" Foreground="#94A3B8" FontSize="11.5" FontFamily="Consolas"/>
                    <TextBlock x:Name="HudVideoText" Grid.Row="0" Grid.Column="1" Text="—" Foreground="#F8FAFC" FontSize="11.5" FontFamily="Consolas"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Audio" Foreground="#94A3B8" FontSize="11.5" FontFamily="Consolas"/>
                    <TextBlock x:Name="HudAudioText" Grid.Row="1" Grid.Column="1" Text="—" Foreground="#F8FAFC" FontSize="11.5" FontFamily="Consolas"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="HW Decode" Foreground="#94A3B8" FontSize="11.5" FontFamily="Consolas"/>
                    <TextBlock x:Name="HudHwDecText" Grid.Row="2" Grid.Column="1" Text="—" Foreground="#38BDF8" FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="FPS" Foreground="#94A3B8" FontSize="11.5" FontFamily="Consolas"/>
                    <TextBlock x:Name="HudFpsText" Grid.Row="3" Grid.Column="1" Text="—" Foreground="#F8FAFC" FontSize="11.5" FontFamily="Consolas"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="RAM Cache" Foreground="#94A3B8" FontSize="11.5" FontFamily="Consolas"/>
                    <TextBlock x:Name="HudCacheText" Grid.Row="4" Grid.Column="1" Text="—" Foreground="#22C55E" FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="A/V Sync" Foreground="#94A3B8" FontSize="11.5" FontFamily="Consolas"/>
                    <TextBlock x:Name="HudAvSyncText" Grid.Row="5" Grid.Column="1" Text="—" Foreground="#F8FAFC" FontSize="11.5" FontFamily="Consolas"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Last Seek" Foreground="#94A3B8" FontSize="11.5" FontFamily="Consolas"/>
                    <TextBlock x:Name="HudSeekText" Grid.Row="6" Grid.Column="1" Text="—" Foreground="#FF6B2B" FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Dropped" Foreground="#94A3B8" FontSize="11.5" FontFamily="Consolas"/>
                    <TextBlock x:Name="HudDroppedText" Grid.Row="7" Grid.Column="1" Text="0" Foreground="#F8FAFC" FontSize="11.5" FontFamily="Consolas"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Directional Skip Back Indicator (Left Center) -->
        <Border x:Name="LeftSkipBadge"
                Opacity="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="48,0,0,0"
                Background="#D80D121E"
                BorderBrush="#44FF6B2B"
                BorderThickness="1"
                CornerRadius="28"
                Padding="20,12"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="LeftSkipScale" ScaleX="0.9" ScaleY="0.9"/>
                    <TranslateTransform x:Name="LeftSkipTranslate" X="14"/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M 11,4 L 4,10 L 11,16 M 18,4 L 11,10 L 18,16"
                      Stroke="#FF6B2B" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="22" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LeftSkipText" Text="-10s" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="LeftSkipTime" Text="00:00" Foreground="#94A3B8" FontSize="11.5" FontFamily="Consolas"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Directional Skip Forward Indicator (Right Center) -->
        <Border x:Name="RightSkipBadge"
                Opacity="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,48,0"
                Background="#D80D121E"
                BorderBrush="#44FF6B2B"
                BorderThickness="1"
                CornerRadius="28"
                Padding="20,12"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RightSkipScale" ScaleX="0.9" ScaleY="0.9"/>
                    <TranslateTransform x:Name="RightSkipTranslate" X="-14"/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="RightSkipText" Text="+10s" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="RightSkipTime" Text="00:00" Foreground="#94A3B8" FontSize="11.5" FontFamily="Consolas" HorizontalAlignment="Right"/>
                </StackPanel>
                <Path Data="M 4,4 L 11,10 L 4,16 M 11,4 L 18,10 L 11,16"
                      Stroke="#FF6B2B" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="22" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Crisp Animated Floating OSD Pill (Top-Center) -->
        <Border x:Name="OsdPill"
                Opacity="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Background="#DF0E1320"
                BorderBrush="#3DFFFFFF"
                BorderThickness="1"
                CornerRadius="22"
                Padding="20,9">
            <Border.RenderTransform>
                <TranslateTransform x:Name="OsdTranslate" Y="-10"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="OsdTitle"
                           Foreground="#FFFFFF"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="OsdSub"
                           Margin="10,0,0,0"
                           Foreground="#94A3B8"
                           FontSize="12.5"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
