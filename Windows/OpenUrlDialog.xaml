<Window x:Class="LiteVLC.Windows.OpenUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Network Stream"
        Width="520"
        Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#131722"
            BorderBrush="#2E364D"
            BorderThickness="1"
            CornerRadius="12"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Open Network Stream"
                       Foreground="#F8FAFC"
                       FontSize="17"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1"
                       Margin="0,4,0,14"
                       Text="Enter an HTTP, HTTPS, HLS (.m3u8), or RTSP media URL:"
                       Foreground="#94A3B8"
                       FontSize="12.5"/>

            <TextBox x:Name="UrlBox"
                     Grid.Row="2"
                     VerticalAlignment="Top"
                     Height="38"
                     Padding="12,8"
                     Background="#0B0D12"
                     Foreground="#F8FAFC"
                     CaretBrush="#FF6B2B"
                     BorderBrush="#334155"
                     BorderThickness="1"
                     FontSize="13.5"
                     KeyDown="UrlBox_KeyDown"/>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="Cancel"
                        Width="92"
                        Height="34"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click"/>
                <Button Content="Play Stream"
                        Width="112"
                        Height="34"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Play_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
