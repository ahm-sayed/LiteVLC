<Window x:Class="LiteVLC.Windows.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiteVLC Update"
        Width="500"
        Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#0E121C"
            BorderBrush="#2A344E"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22,18,22,20">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/LiteVLC.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="HeadlineText" Text="Checking for updates..." Foreground="#F8FAFC" FontSize="15.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionLineText" Text="github.com/ahm-sayed/LiteVLC" Foreground="#94A3B8" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButtonStyle}" Padding="8,6" Click="Close_Click">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- Status Pill -->
            <Border x:Name="StatusBanner" Grid.Row="1" Background="#121827" BorderBrush="#24304B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <TextBlock x:Name="StatusText" Text="Contacting GitHub Releases..." Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Release Notes -->
            <Border Grid.Row="2" Background="#090C13" BorderBrush="#1C2438" BorderThickness="1" CornerRadius="9" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText"
                               Text=""
                               Foreground="#94A3B8"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- Download Progress Bar -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,12,0,0">
                <Grid Margin="0,0,0,5">
                    <TextBlock x:Name="ProgressStatusText" Text="Downloading update..." Foreground="#E2E8F0" FontSize="11.5"/>
                    <TextBlock x:Name="ProgressPctText" Text="0%" HorizontalAlignment="Right" Foreground="#FF6B2B" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"/>
                </Grid>
                <Grid Height="7">
                    <Border Background="#1D2539" CornerRadius="3.5"/>
                    <Border x:Name="ProgressFill" CornerRadius="3.5" RenderTransformOrigin="0,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF5A1F" Offset="0"/>
                                <GradientStop Color="#FF8B42" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CloseBtn" Content="Close" Width="92" Height="34" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
                <Button x:Name="UpdateBtn" Content="Update Now" Width="140" Height="34" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" Click="UpdateNow_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
