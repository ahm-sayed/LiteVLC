<Window x:Class="LiteVLC.Windows.FullscreenControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="548"
        Height="74"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="8,8,8,0">
        <!-- Ultra-Slim Bottom-Hugging VLC-Style Floating Controller (stays below subtitles) -->
        <Border x:Name="DockCard"
                Opacity="0"
                Background="#E60B0F1A"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,4,12,6">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockTranslate" Y="8"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Slim GPU-Transformed Seek Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,3">
                    <Popup x:Name="SeekHoverPopup"
                           PlacementTarget="{Binding ElementName=SeekTrackSurface}"
                           Placement="Relative"
                           AllowsTransparency="True"
                           IsHitTestVisible="False">
                        <Border Background="#F2111622" BorderBrush="#39486B" BorderThickness="1" CornerRadius="5" Padding="7,2">
                            <TextBlock x:Name="SeekHoverTimeText"
                                       Text="00:00"
                                       Foreground="#F8FAFC"
                                       FontFamily="Consolas"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Popup>

                    <Grid x:Name="SeekTrackSurface"
                          Height="14"
                          Background="Transparent"
                          Cursor="Hand"
                          MouseEnter="SeekTrack_MouseEnter"
                          MouseLeftButtonDown="SeekTrack_MouseLeftButtonDown"
                          MouseMove="SeekTrack_MouseMove"
                          MouseLeftButtonUp="SeekTrack_MouseLeftButtonUp"
                          MouseLeave="SeekTrack_MouseLeave">
                        <Grid Height="3.5" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SeekBarHeightScale" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border CornerRadius="2" Background="#2A334A"/>
                            <Border CornerRadius="2" Background="#465A80" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SeekCacheScale" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border CornerRadius="2" RenderTransformOrigin="0,0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF5A1F" Offset="0"/>
                                        <GradientStop Color="#FF8B42" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SeekFillScale" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <Ellipse x:Name="SeekThumb"
                                 Width="11"
                                 Height="11"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Fill="#FFFFFF"
                                 Stroke="#FF6B2B"
                                 StrokeThickness="2"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SeekThumbScale" ScaleX="0.85" ScaleY="0.85"/>
                                    <TranslateTransform x:Name="SeekThumbTranslate" X="0"/>
                                </TransformGroup>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Grid>

                <!-- Slim Single-Row Controls -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Compact Time Readout -->
                    <TextBlock x:Name="TimeReadoutText"
                               Grid.Column="0"
                               Text="00:00 / 00:00"
                               MinWidth="96"
                               FontFamily="Consolas"
                               FontSize="10.5"
                               Foreground="#CBD5E1"
                               VerticalAlignment="Center"/>

                    <!-- Center: Compact Transport -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Padding="5,4" ToolTip="Previous (P)" Click="Prev_Click">
                            <Path Data="M 3,3 L 3,13 M 13,3 L 5,8 L 13,13 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}" Margin="2,0" Padding="6,4" ToolTip="-10s (Left)" Click="SeekBack10_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8,3 L 2,8 L 8,13 M 14,3 L 8,8 L 14,13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="10" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="10" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PlayCircleButtonStyle}" Width="28" Height="28" Margin="4,0" ToolTip="Play / Pause (Space)" Click="PlayPause_Click">
                            <Path x:Name="PlayPausePath"
                                  Data="M 4,2 L 15,8.5 L 4,15 Z"
                                  Fill="#FFFFFF"
                                  Width="10" Height="11" Stretch="Uniform"
                                  Margin="1.5,0,0,0"/>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}" Margin="2,0" Padding="6,4" ToolTip="+10s (Right)" Click="SeekForward10_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="10" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Path Data="M 2,3 L 8,8 L 2,13 M 8,3 L 14,8 L 8,13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="10" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}" Padding="5,4" ToolTip="Next (N)" Click="Next_Click">
                            <Path Data="M 13,3 L 13,13 M 3,3 L 11,8 L 3,13 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- Right: Slim Volume + Speed + Fit + Exit FS -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Padding="5,4" ToolTip="Mute (M)" Click="Mute_Click">
                            <Path x:Name="VolumeIconPath"
                                  Data="M 2,7 L 6,7 L 11,3 L 11,15 L 6,11 L 2,11 Z M 14,6 C 15.5,7.5 15.5,10.5 14,12 M 16.5,4 C 19,6.8 19,11.2 16.5,14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                  Width="12" Height="11" Stretch="Uniform"/>
                        </Button>

                        <Slider x:Name="VolumeSlider"
                                Width="54"
                                Minimum="0"
                                Maximum="200"
                                Value="100"
                                Style="{StaticResource SlimSliderStyle}"
                                VerticalAlignment="Center"
                                Margin="1,0,6,0"
                                ValueChanged="VolumeSlider_ValueChanged"
                                ToolTip="Volume (0–200%)"/>

                        <Button x:Name="SpeedBtn"
                                Content="1.0x"
                                Style="{StaticResource PillButtonStyle}"
                                Padding="6,2"
                                FontSize="10.5"
                                Margin="0,0,3,0"
                                ToolTip="Cycle Speed"
                                Click="Speed_Click"/>

                        <Button x:Name="AspectBtn"
                                Content="Fit"
                                Style="{StaticResource PillButtonStyle}"
                                Padding="6,2"
                                FontSize="10.5"
                                Margin="0,0,3,0"
                                ToolTip="Video Fit / Fill (A)"
                                Click="Aspect_Click"/>

                        <Button Style="{StaticResource IconButtonStyle}" Padding="5,4" ToolTip="Exit Fullscreen (F / Esc)" Click="ExitFullscreen_Click">
                            <Path Data="M 6,2 L 6,6 L 2,6 M 12,2 L 12,6 L 16,6 M 16,12 L 12,12 L 12,16 M 2,12 L 6,12 L 6,16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
