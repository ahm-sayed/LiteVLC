<Window x:Class="LiteVLC.Windows.TrimVideoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trim / Cut Video — LiteVLC"
        Width="540"
        Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#0E121C"
            BorderBrush="#2A344E"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22,18,22,20">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#22FF6B2B" BorderBrush="#44FF6B2B" BorderThickness="1" Margin="0,0,10,0">
                        <Path Data="M 4,4 L 14,14 M 14,4 L 4,14 M 4,15 A 2,2 0 1 0 4,11 M 14,15 A 2,2 0 1 0 14,11"
                              Stroke="#FF6B2B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Trim / Cut Video Clip" Foreground="#F8FAFC" FontSize="15.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FileNameText" Text="video.mp4" Foreground="#64748B" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="390"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButtonStyle}" Padding="8,6" Click="Close_Click">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- Visual Segment Range Indicator -->
            <Border Grid.Row="1" Background="#090C13" BorderBrush="#1C2438" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,7">
                        <TextBlock x:Name="RangeSummaryText" Text="Selected Clip: 00:00 → 00:30" Foreground="#E2E8F0" FontSize="12" FontWeight="Medium"/>
                        <TextBlock x:Name="ClipDurationText" Text="Duration: 00:30" HorizontalAlignment="Right" Foreground="#FF8B42" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid x:Name="RangeBarTrack" Height="10">
                        <Border Background="#1D2539" CornerRadius="5"/>
                        <Border x:Name="RangeHighlight" HorizontalAlignment="Left" Width="120" CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF5A1F" Offset="0"/>
                                    <GradientStop Color="#FF9248" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Start & End Time Controls -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Start Time -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Start Time (HH:MM:SS)" Foreground="#94A3B8" FontSize="11" Margin="2,0,0,4"/>
                    <TextBox x:Name="StartBox"
                             Height="34"
                             Padding="10,6"
                             Background="#090C13"
                             Foreground="#F8FAFC"
                             CaretBrush="#FF6B2B"
                             BorderBrush="#2C3752"
                             BorderThickness="1"
                             FontFamily="Consolas"
                             FontSize="13.5"
                             TextChanged="TimeBox_TextChanged"/>
                    <Button Content="Use Current Playback Time"
                            Margin="0,6,0,0"
                            Style="{StaticResource PillButtonStyle}"
                            FontSize="11"
                            Click="SetStartCurrent_Click"/>
                </StackPanel>

                <!-- End Time -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="End Time (HH:MM:SS)" Foreground="#94A3B8" FontSize="11" Margin="2,0,0,4"/>
                    <TextBox x:Name="EndBox"
                             Height="34"
                             Padding="10,6"
                             Background="#090C13"
                             Foreground="#F8FAFC"
                             CaretBrush="#FF6B2B"
                             BorderBrush="#2C3752"
                             BorderThickness="1"
                             FontFamily="Consolas"
                             FontSize="13.5"
                             TextChanged="TimeBox_TextChanged"/>
                    <Button Content="Use Current Playback Time"
                            Margin="0,6,0,0"
                            Style="{StaticResource PillButtonStyle}"
                            FontSize="11"
                            Click="SetEndCurrent_Click"/>
                </StackPanel>
            </Grid>

            <!-- Mode Selection -->
            <Border Grid.Row="3" Background="#111624" BorderBrush="#212A42" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                <StackPanel>
                    <RadioButton x:Name="ExactModeRadio"
                                 Content="Frame-Exact Cut (Built-in H.264/AAC — exact to the second, works everywhere)"
                                 Foreground="#E2E8F0"
                                 FontSize="12"
                                 IsChecked="True"
                                 Margin="0,0,0,6"/>
                    <RadioButton x:Name="FastCopyRadio"
                                 Content="Instant Lossless Stream Copy (Zero re-encoding, near-instant)"
                                 Foreground="#94A3B8"
                                 FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Progress & Status -->
            <StackPanel Grid.Row="4">
                <Grid Margin="0,0,0,5">
                    <TextBlock x:Name="StatusText" Text="Ready to cut clip." Foreground="#94A3B8" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PctText" Text="" HorizontalAlignment="Right" Foreground="#4ADE80" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"/>
                </Grid>
                <Grid x:Name="ProgressGrid" Height="7" Visibility="Collapsed">
                    <Border Background="#1D2539" CornerRadius="3.5"/>
                    <Border CornerRadius="3.5" RenderTransformOrigin="0,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#22C55E" Offset="0"/>
                                <GradientStop Color="#4ADE80" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="OpenFolderBtn"
                        Content="Open Folder"
                        Width="104"
                        Height="34"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OpenFolder_Click"/>
                <Button x:Name="CloseBtn"
                        Content="Close"
                        Width="88"
                        Height="34"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Close_Click"/>
                <Button x:Name="CutBtn"
                        Content="Cut &amp; Save Clip..."
                        Width="148"
                        Height="34"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Cut_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
