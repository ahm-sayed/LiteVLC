<Window x:Class="LiteVLC.Windows.SubtitleSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Subtitles — LiteVLC"
        Width="740"
        Height="560"
        MinWidth="620"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#0E121C"
            BorderBrush="#2A344E"
            BorderThickness="1"
            CornerRadius="14"
            Padding="20,16,20,18">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.65"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Search Controls -->
                <RowDefinition Height="Auto"/> <!-- Status / IMDB Info -->
                <RowDefinition Height="*"/>    <!-- Results List -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Header (Draggable) -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#22FF6B2B" BorderBrush="#44FF6B2B" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="CC" Foreground="#FF6B2B" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Search Subtitles Online" Foreground="#F8FAFC" FontSize="15.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Exact file-hash sync + IMDB movie &amp; series matching (UTF-8 Arabic ready)" Foreground="#64748B" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource IconButtonStyle}"
                        Padding="8,6"
                        Click="Close_Click"
                        ToolTip="Close (Esc)">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- Search Bar: Title + Season + Episode + Language + Search Button -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="136"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Title / Movie / Series" Foreground="#94A3B8" FontSize="11" Margin="2,0,0,4"/>
                    <TextBox x:Name="QueryBox"
                             Height="34"
                             Padding="10,7"
                             Background="#090C13"
                             Foreground="#F8FAFC"
                             CaretBrush="#FF6B2B"
                             BorderBrush="#2C3752"
                             BorderThickness="1"
                             FontSize="13"
                             KeyDown="Input_KeyDown"/>
                </StackPanel>

                <!-- Season -->
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="Season" Foreground="#94A3B8" FontSize="11" Margin="2,0,0,4"/>
                    <TextBox x:Name="SeasonBox"
                             Height="34"
                             Padding="8,7"
                             Background="#090C13"
                             Foreground="#F8FAFC"
                             CaretBrush="#FF6B2B"
                             BorderBrush="#2C3752"
                             BorderThickness="1"
                             FontSize="13"
                             HorizontalContentAlignment="Center"
                             KeyDown="Input_KeyDown"/>
                </StackPanel>

                <!-- Episode -->
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Episode" Foreground="#94A3B8" FontSize="11" Margin="2,0,0,4"/>
                    <TextBox x:Name="EpisodeBox"
                             Height="34"
                             Padding="8,7"
                             Background="#090C13"
                             Foreground="#F8FAFC"
                             CaretBrush="#FF6B2B"
                             BorderBrush="#2C3752"
                             BorderThickness="1"
                             FontSize="13"
                             HorizontalContentAlignment="Center"
                             KeyDown="Input_KeyDown"/>
                </StackPanel>

                <!-- Language -->
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Language" Foreground="#94A3B8" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox x:Name="LangCombo"
                              Height="34"
                              Background="#090C13"
                              Foreground="#F8FAFC"
                              BorderBrush="#2C3752"
                              BorderThickness="1"
                              FontSize="12.5"
                              VerticalContentAlignment="Center">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#121724"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#253252"/>
                        </ComboBox.Resources>
                        <ComboBoxItem Content="Arabic" Tag="ara" Foreground="#F8FAFC" Background="#121724"/>
                        <ComboBoxItem Content="Arabic + English" Tag="ara,eng" Foreground="#F8FAFC" Background="#121724"/>
                        <ComboBoxItem Content="English" Tag="eng" Foreground="#F8FAFC" Background="#121724"/>
                        <ComboBoxItem Content="French" Tag="fre" Foreground="#F8FAFC" Background="#121724"/>
                        <ComboBoxItem Content="Spanish" Tag="spa" Foreground="#F8FAFC" Background="#121724"/>
                        <ComboBoxItem Content="German" Tag="ger" Foreground="#F8FAFC" Background="#121724"/>
                        <ComboBoxItem Content="Turkish" Tag="tur" Foreground="#F8FAFC" Background="#121724"/>
                        <ComboBoxItem Content="All Languages" Tag="all" Foreground="#F8FAFC" Background="#121724"/>
                    </ComboBox>
                </StackPanel>

                <!-- Search Button -->
                <Button x:Name="SearchBtn"
                        Grid.Column="4"
                        Content="Search"
                        Width="92"
                        Height="34"
                        VerticalAlignment="Bottom"
                        FontSize="12.5"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Search_Click"/>
            </Grid>

            <!-- Status & Hash / IMDB Match Strip -->
            <Border Grid.Row="2"
                    Background="#0A0E16"
                    BorderBrush="#1C2438"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,7"
                    Margin="0,0,0,10">
                <Grid>
                    <TextBlock x:Name="StatusText"
                               Text="Ready to search..."
                               Foreground="#94A3B8"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="HashBadgeText"
                               HorizontalAlignment="Right"
                               Foreground="#4ADE80"
                               FontFamily="Consolas"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Results List -->
            <Border Grid.Row="3"
                    Background="#0A0D14"
                    BorderBrush="#1D2539"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="4">
                <ListBox x:Name="ResultsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#E2E8F0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         SelectionChanged="ResultsList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,9">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#161D2E"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1E2840"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55FF6B2B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="#F8FAFC"
                                               FontSize="12.5"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding MetaLine}"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{Binding MatchBadgeBg}"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MatchBadge}"
                                               Foreground="{Binding MatchBadgeFg}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Footer Actions -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Text="Tip: Double-click any subtitle to download &amp; apply instantly. Use G / H to fine-tune sync."
                           Foreground="#64748B"
                           FontSize="11.5"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Width="90"
                            Height="34"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Close_Click"/>
                    <Button x:Name="ApplyBtn"
                            Content="Download &amp; Apply"
                            Width="148"
                            Height="34"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Apply_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
