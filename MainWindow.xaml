<Window x:Class="LiteVLC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LiteVLC"
        Icon="pack://application:,,,/Assets/LiteVLC.ico"
        Width="1120"
        Height="742"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#080A0F"
        Foreground="#F8FAFC"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="AppWindowChrome"
                            CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="#1C2336" BorderThickness="1" Background="#080A0F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Custom Title Bar -->
                <RowDefinition Height="*"/>    <!-- Video Stage + Animated Playlist Drawer -->
                <RowDefinition Height="Auto"/> <!-- Bottom Control Deck -->
            </Grid.RowDefinitions>

            <!-- ==================== TOP CUSTOM TITLE BAR ==================== -->
            <Border x:Name="TopBar"
                    Grid.Row="0"
                    Height="40"
                    Background="#0C1019"
                    BorderBrush="#192032"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Icon + Quick File/Stream Actions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                        <Image Source="pack://application:,,,/Assets/LiteVLC.png"
                               Width="22" Height="22"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,8,0"/>
                        <TextBlock Text="LiteVLC"
                                   FontWeight="Bold"
                                   FontSize="13.5"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center"/>
                        <Border Width="1" Height="15" Background="#232C42" Margin="12,0"/>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Padding="9,5"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OpenFile_Click"
                                ToolTip="Open Media File (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2,5 C 2,3.9 2.9,3 4,3 L 8.5,3 L 10.5,5 L 18,5 C 19.1,5 20,5.9 20,7 L 20,16 C 20,17.1 19.1,18 18,18 L 4,18 C 2.9,18 2,17.1 2,16 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Open" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Padding="9,5"
                                Margin="2,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OpenUrl_Click"
                                ToolTip="Open Network Stream (Ctrl+U)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 10,2 A 8,8 0 1 0 10,18 A 8,8 0 1 0 10,2 M 2,10 L 18,10 M 10,2 C 12.5,4.8 12.5,15.2 10,18 C 7.5,15.2 7.5,4.8 10,2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="Transparent"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Stream" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Padding="9,5"
                                Margin="2,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="SearchSubtitles_Click"
                                ToolTip="Search Subtitles Online (D / Ctrl+Shift+S)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8,2 A 6,6 0 1 0 8,14 A 6,6 0 1 0 8,2 M 12.5,12.5 L 17,17"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Subtitles" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Centered Media Title -->
                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Text="Ready • Direct3D 11 Engine"
                               Foreground="#94A3B8"
                               FontSize="12.5"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="14,0"/>

                    <!-- Engine / Resume Toggles + Window Caption Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Audio Boost (VLC-Parity Loudness / Dialogue Normalizer) Pill -->
                        <Button x:Name="AudioBoostBadgeBtn"
                                Style="{StaticResource PillButtonStyle}"
                                Padding="8,4"
                                Margin="0,0,6,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="ToggleAudioBoost_Click"
                                ToolTip="Toggle Dynamic Audio Boost (Louder Dialogue &amp; 5.1 Normalization)">
                            <TextBlock x:Name="AudioBoostBadgeText" Text="Boost: ON" FontSize="11"/>
                        </Button>

                        <!-- Resume Last Scene Option Pill -->
                        <Button x:Name="ResumeBadgeBtn"
                                Style="{StaticResource PillButtonStyle}"
                                Padding="9,4"
                                Margin="0,0,6,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="ToggleResume_Click"
                                ToolTip="Auto-Resume from last scene when reopening a video">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 4,10 A 6,6 0 1 1 6,14.5 M 4,6 L 4,10 L 8,10 M 10,7 L 10,10.5 L 12.5,12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock x:Name="ResumeBadgeText" Text="Resume: ON" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <!-- Fast Seek Toggle Pill -->
                        <Button x:Name="FastSeekBadgeBtn"
                                Style="{StaticResource PillButtonStyle}"
                                Padding="9,4"
                                Margin="0,0,6,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="ToggleFastSeek_Click"
                                ToolTip="Toggle Instant Keyframe Seek (Zero Lag) vs Exact Frame Seek">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 11,2 L 4,11 L 10,11 L 9,18 L 16,9 L 10,9 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="10" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock x:Name="FastSeekBadgeText" Text="Fast Seek" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <!-- Performance HUD Toggle -->
                        <Button x:Name="HudToggleBtn"
                                Style="{StaticResource PillButtonStyle}"
                                Padding="8,4"
                                Margin="0,0,6,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="ToggleHud_Click"
                                ToolTip="Toggle Performance HUD (I)">
                            <TextBlock Text="HUD" FontSize="11" FontWeight="SemiBold"/>
                        </Button>

                        <!-- GitHub Auto-Update Button -->
                        <Button x:Name="UpdateBtn"
                                Style="{StaticResource PillButtonStyle}"
                                Padding="8,4"
                                Margin="0,0,6,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="CheckUpdate_Click"
                                ToolTip="Check for Updates on GitHub">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="UpdateDot"
                                         Width="6" Height="6"
                                         Fill="#22C55E"
                                         Margin="0,0,5,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                                <TextBlock x:Name="UpdateBtnText" Text="Update" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <!-- Always on Top Pin -->
                        <Button x:Name="PinBtn"
                                Style="{StaticResource IconButtonStyle}"
                                Padding="8,6"
                                Margin="0,0,4,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="ToggleAlwaysOnTop_Click"
                                ToolTip="Always on Top">
                            <Path Data="M 12,2 L 15,5 L 12.5,7.5 L 14,11 L 9,11 L 9,17 L 7,17 L 7,11 L 2,11 L 3.5,7.5 L 1,5 L 4,2 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </Button>

                        <!-- Minimize -->
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Minimize_Click"
                                ToolTip="Minimize">
                            <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                        </Button>

                        <!-- Maximize / Restore -->
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="MaxRestore_Click"
                                ToolTip="Maximize / Restore">
                            <Path x:Name="MaxRestorePath"
                                  Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" Fill="Transparent"/>
                        </Button>

                        <!-- Close -->
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Close_Click"
                                ToolTip="Close">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN VIDEO STAGE + ANIMATED PLAYLIST ==================== -->
            <Grid Grid.Row="1" Background="#000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Native D3D11 Video Host Container -->
                <Grid x:Name="StageContainer" Grid.Column="0" Background="#000000">
                    <ContentControl x:Name="VideoHostSlot"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Visibility="Collapsed"/>

                    <!-- Polished Cinema Empty State / Drop Zone -->
                    <Grid x:Name="EmptyStatePanel">
                        <Grid.Background>
                            <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.6" RadiusY="0.65">
                                <GradientStop Color="#141929" Offset="0"/>
                                <GradientStop Color="#080A0F" Offset="1"/>
                            </RadialGradientBrush>
                        </Grid.Background>

                        <Border MaxWidth="560"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Background="#D90F1420"
                                BorderBrush="#242E47"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="38,32">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="36" ShadowDepth="10" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/LiteVLC.png"
                                       Width="68" Height="68"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,14"/>

                                <TextBlock Text="LiteVLC"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#F8FAFC"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Direct3D 11 Hardware Decode  •  Zero-Lag ±10s Seek  •  Auto-Resume"
                                           FontSize="12.5"
                                           Foreground="#94A3B8"
                                           Margin="0,6,0,24"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                                    <Button Content="Open Media File"
                                            Width="164"
                                            Height="42"
                                            Margin="0,0,12,0"
                                            FontSize="13"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="OpenFile_Click"/>
                                    <Button Content="Open Stream URL"
                                            Width="164"
                                            Height="42"
                                            FontSize="13"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="OpenUrl_Click"/>
                                </StackPanel>

                                <!-- Recent Files with Saved Resume Timestamp Badges -->
                                <StackPanel x:Name="RecentFilesSection" Visibility="Collapsed" Margin="0,0,0,18">
                                    <TextBlock Text="CONTINUE WATCHING"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="#64748B"
                                               Margin="4,0,0,7"/>
                                    <ItemsControl x:Name="RecentFilesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="10,7"
                                                        Margin="0,2"
                                                        Tag="{Binding Path}"
                                                        Click="RecentFile_Click">
                                                    <Grid Width="450">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="0"
                                                              Data="M 3,2 L 12,7.5 L 3,13 Z"
                                                              Fill="#FF6B2B"
                                                              Width="9" Height="11" Stretch="Uniform"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding FileName}"
                                                                   Foreground="#E2E8F0"
                                                                   FontSize="12.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2"
                                                                Background="#13291E"
                                                                BorderBrush="#25573C"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                Padding="7,2"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasResume}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding ResumeBadge}"
                                                                       Foreground="#4ADE80"
                                                                       FontFamily="Consolas"
                                                                       FontSize="10.5"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Quick Shortcut Strip -->
                                <Border Background="#0A0D14" BorderBrush="#1B2236" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <TextBlock Text="Drag &amp; Drop videos or .srt subtitles  •  Space: Play  •  ← / →: ±10s  •  0: Restart  •  Double-Click / F: Fullscreen"
                                               Foreground="#64748B"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Smoothly Animated Collapsible Playlist Side Drawer -->
                <Border x:Name="PlaylistDrawer"
                        Grid.Column="1"
                        Width="0"
                        Opacity="0"
                        Visibility="Collapsed"
                        Background="#0D111C"
                        BorderBrush="#1C2438"
                        BorderThickness="1,0,0,0"
                        ClipToBounds="True">
                    <Grid Width="310">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="14,12" BorderBrush="#1A2234" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock x:Name="PlaylistHeaderText"
                                           Text="Playlist (0)"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F8FAFC"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="LoopBtn"
                                            Content="Loop: Off"
                                            Style="{StaticResource PillButtonStyle}"
                                            Padding="8,3"
                                            FontSize="11"
                                            Margin="0,0,6,0"
                                            Click="CycleLoopMode_Click"/>
                                    <Button Content="+"
                                            Style="{StaticResource IconButtonStyle}"
                                            Padding="8,3"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            ToolTip="Add Files to Playlist"
                                            Click="AddToPlaylist_Click"/>
                                    <Button Content="Clear"
                                            Style="{StaticResource IconButtonStyle}"
                                            Padding="7,3"
                                            FontSize="11.5"
                                            Click="ClearPlaylist_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox x:Name="PlaylistListBox"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#E2E8F0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="PlaylistListBox_MouseDoubleClick"
                                 MouseRightButtonUp="PlaylistListBox_MouseRightButtonUp"
                                 Padding="7">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="10,8.5">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#1A2236"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#232D47"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" Height="16" CornerRadius="2" Margin="0,0,9,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Background" Value="#FF6B2B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#CBD5E1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DurationText}"
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   FontFamily="Consolas"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Padding="10,9" BorderBrush="#1A2234" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Load (.xspf / .m3u8)"
                                        Style="{StaticResource PillButtonStyle}"
                                        Padding="8,5"
                                        Margin="0,0,4,0"
                                        FontSize="11"
                                        ToolTip="Open a saved XSPF or M3U8 playlist file"
                                        Click="LoadPlaylist_Click"/>
                                <Button Grid.Column="1"
                                        Content="Save Playlist"
                                        Style="{StaticResource PillButtonStyle}"
                                        Padding="8,5"
                                        Margin="4,0,0,0"
                                        FontSize="11"
                                        ToolTip="Save current playlist as VLC-compatible .xspf or .m3u8"
                                        Click="SavePlaylist_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== BOTTOM CONTROL DECK ==================== -->
            <Border x:Name="BottomDeck"
                    Grid.Row="2"
                    Background="#0C1019"
                    BorderBrush="#192032"
                    BorderThickness="0,1,0,0"
                    Padding="16,6,16,11"
                    MouseEnter="BottomDeck_MouseEnter"
                    MouseLeave="BottomDeck_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Zero-Layout-Thrash Animated Seek Bar -->
                        <RowDefinition Height="Auto"/> <!-- Transport & Feature Controls -->
                    </Grid.RowDefinitions>

                    <!-- GPU-Transformed Precision Seek Bar (Zero WPF Layout Pass During Playback!) -->
                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <Popup x:Name="SeekHoverPopup"
                               PlacementTarget="{Binding ElementName=SeekTrackSurface}"
                               Placement="Relative"
                               AllowsTransparency="True"
                               IsHitTestVisible="False">
                            <Border Background="#F0111622" BorderBrush="#39486B" BorderThickness="1" CornerRadius="6" Padding="9,3.5">
                                <TextBlock x:Name="SeekHoverTimeText"
                                           Text="00:00"
                                           Foreground="#F8FAFC"
                                           FontFamily="Consolas"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Popup>

                        <Grid x:Name="SeekTrackSurface"
                              Height="22"
                              Background="Transparent"
                              Cursor="Hand"
                              MouseEnter="SeekTrack_MouseEnter"
                              MouseLeftButtonDown="SeekTrack_MouseLeftButtonDown"
                              MouseMove="SeekTrack_MouseMove"
                              MouseLeftButtonUp="SeekTrack_MouseLeftButtonUp"
                              MouseLeave="SeekTrack_MouseLeave"
                              MouseWheel="SeekTrack_MouseWheel">
                            <!-- Track Bars Container (scales smoothly in Y on hover) -->
                            <Grid x:Name="SeekBarsHolder" Height="4" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="SeekBarHeightScale" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <!-- Base Track -->
                                <Border CornerRadius="2" Background="#20273B"/>
                                <!-- RAM Cached Ahead Bar (GPU ScaleX) -->
                                <Border x:Name="SeekCacheBar"
                                        CornerRadius="2"
                                        Background="#36486B"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="SeekCacheScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                                <!-- Playback Progress Fill (GPU ScaleX) -->
                                <Border x:Name="SeekFillBar"
                                        CornerRadius="2"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF5A1F" Offset="0"/>
                                            <GradientStop Color="#FF8B42" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="SeekFillScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <!-- Crisp Scrub Thumb (GPU TranslateX + Hover Scale) -->
                            <Ellipse x:Name="SeekThumb"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="#FFFFFF"
                                     Stroke="#FF6B2B"
                                     StrokeThickness="2.5"
                                     Visibility="Collapsed"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="SeekThumbScale" ScaleX="0.85" ScaleY="0.85"/>
                                        <TranslateTransform x:Name="SeekThumbTranslate" X="0"/>
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>

                    <!-- Controls Row -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Fixed-Width Time Readout + Seek Latency Pill -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TimeReadoutText"
                                       Text="00:00 / 00:00"
                                       MinWidth="128"
                                       FontFamily="Consolas"
                                       FontSize="12.5"
                                       Foreground="#CBD5E1"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="SeekLatencyBadge"
                                    Visibility="Collapsed"
                                    Background="#0F2418"
                                    BorderBrush="#225236"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="SeekLatencyText"
                                           Text="12ms"
                                           Foreground="#4ADE80"
                                           FontFamily="Consolas"
                                           FontSize="10.5"/>
                            </Border>
                        </StackPanel>

                        <!-- Center: Vector Transport Cluster -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Previous -->
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Padding="9,7"
                                    ToolTip="Previous (P)"
                                    Click="Prev_Click">
                                <Path Data="M 3,3 L 3,13 M 13,3 L 5,8 L 13,13 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform"/>
                            </Button>

                            <!-- Rewind 10s -->
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Margin="5,0"
                                    Padding="10,6"
                                    ToolTip="Rewind 10s (Left Arrow)"
                                    Click="SeekBack10_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 8,3 L 2,8 L 8,13 M 14,3 L 8,8 L 14,13"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="10s" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Hero Play/Pause -->
                            <Button x:Name="PlayPauseBtn"
                                    Style="{StaticResource PlayCircleButtonStyle}"
                                    Margin="6,0"
                                    ToolTip="Play / Pause (Space)"
                                    Click="PlayPause_Click">
                                <Path x:Name="PlayPausePath"
                                      Data="M 4,2 L 15,8.5 L 4,15 Z"
                                      Fill="#FFFFFF"
                                      Width="14" Height="15" Stretch="Uniform"
                                      Margin="2,0,0,0"/>
                            </Button>

                            <!-- Forward 10s -->
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Margin="5,0"
                                    Padding="10,6"
                                    ToolTip="Forward 10s (Right Arrow)"
                                    Click="SeekForward10_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="10s" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Path Data="M 2,3 L 8,8 L 2,13 M 8,3 L 14,8 L 8,13"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Next -->
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Padding="9,7"
                                    ToolTip="Next (N)"
                                    Click="Next_Click">
                                <Path Data="M 13,3 L 13,13 M 3,3 L 11,8 L 3,13 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform"/>
                            </Button>

                            <!-- Stop -->
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Padding="9,7"
                                    Margin="3,0,0,0"
                                    ToolTip="Stop"
                                    Click="Stop_Click">
                                <Path Data="M 3,3 L 13,3 L 13,13 L 3,13 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="11" Height="11" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- Right: Volume + Speed + Tracks + Utility Vector Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Volume / Mute -->
                            <Button x:Name="MuteBtn"
                                    Style="{StaticResource IconButtonStyle}"
                                    Padding="7,6"
                                    ToolTip="Mute / Unmute (M)"
                                    Click="Mute_Click">
                                <Path x:Name="VolumeIconPath"
                                      Data="M 2,7 L 6,7 L 11,3 L 11,15 L 6,11 L 2,11 Z M 14,6 C 15.5,7.5 15.5,10.5 14,12 M 16.5,4 C 19,6.8 19,11.2 16.5,14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                      Width="16" Height="14" Stretch="Uniform"/>
                            </Button>

                            <Slider x:Name="VolumeSlider"
                                    Width="84"
                                    Minimum="0"
                                    Maximum="200"
                                    Value="100"
                                    Style="{StaticResource SlimSliderStyle}"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged"
                                    MouseWheel="VolumeSlider_MouseWheel"
                                    ToolTip="Volume (0–200% VLC Boost)"/>

                            <TextBlock x:Name="VolumeText"
                                       Text="100%"
                                       Width="36"
                                       FontFamily="Consolas"
                                       FontSize="11.5"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"
                                       Margin="5,0,10,0"/>

                            <Button x:Name="SpeedBtn"
                                    Content="1.0x"
                                    Style="{StaticResource PillButtonStyle}"
                                    Margin="0,0,5,0"
                                    ToolTip="Playback Speed ([ / ])"
                                    Click="SpeedBtn_Click"/>

                            <Button x:Name="AudioTrackBtn"
                                    Content="Audio"
                                    Style="{StaticResource PillButtonStyle}"
                                    Margin="0,0,5,0"
                                    ToolTip="Audio Tracks (B)"
                                    Click="AudioTrackBtn_Click"/>

                            <Button x:Name="SubTrackBtn"
                                    Content="CC"
                                    Style="{StaticResource PillButtonStyle}"
                                    Margin="0,0,5,0"
                                    ToolTip="Subtitles (V)"
                                    Click="SubTrackBtn_Click"/>

                            <Button x:Name="AspectBtn"
                                    Content="Fit"
                                    Style="{StaticResource PillButtonStyle}"
                                    Margin="0,0,6,0"
                                    ToolTip="Video Fill / Aspect Ratio (A) — Remove Black Bars"
                                    Click="AspectBtn_Click"/>

                            <!-- Trim / Cut Video Clip -->
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Padding="8,6"
                                    ToolTip="Trim / Cut Video Clip (Ctrl+T / K)"
                                    Click="TrimVideo_Click">
                                <Path Data="M 4,4 L 14,14 M 14,4 L 4,14 M 4,15 A 2,2 0 1 0 4,11 M 14,15 A 2,2 0 1 0 14,11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="13" Stretch="Uniform"/>
                            </Button>

                            <!-- Screenshot -->
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Padding="8,6"
                                    ToolTip="Screenshot (S)"
                                    Click="Screenshot_Click">
                                <Path Data="M 2,6 C 2,4.9 2.9,4 4,4 L 6,4 L 7.5,2 L 12.5,2 L 14,4 L 16,4 C 17.1,4 18,4.9 18,6 L 18,14 C 18,15.1 17.1,16 16,16 L 4,16 C 2.9,16 2,15.1 2,14 Z M 10,7 A 3,3 0 1 0 10,13 A 3,3 0 1 0 10,7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"
                                      Width="15" Height="13" Stretch="Uniform"/>
                            </Button>

                            <!-- Playlist Toggle -->
                            <Button x:Name="PlaylistToggleBtn"
                                    Style="{StaticResource IconButtonStyle}"
                                    Padding="8,6"
                                    ToolTip="Playlist (Ctrl+L)"
                                    Click="TogglePlaylist_Click">
                                <Path Data="M 2,4 L 16,4 M 2,9 L 16,9 M 2,14 L 11,14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="12" Stretch="Uniform"/>
                            </Button>

                            <!-- Fullscreen Toggle -->
                            <Button x:Name="FullscreenBtn"
                                    Style="{StaticResource IconButtonStyle}"
                                    Padding="8,6"
                                    ToolTip="Fullscreen (F / Double-Click)"
                                    Click="ToggleFullscreen_Click">
                                <Path x:Name="FullscreenIconPath"
                                      Data="M 2,6 L 2,2 L 6,2 M 12,2 L 16,2 L 16,6 M 16,12 L 16,16 L 12,16 M 6,16 L 2,16 L 2,12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
